# Copier en .env (cp .env.example .env) : docker compose le lit automatiquement.

# Phase 1 : détecteur factice, images légères
DETECTOR=dummy
INSTALL_YOLO=false

# Phase 2 : vrai modèle Pyronear (image caméra ~2,3 Go, inférence sur CPU)
# DETECTOR=yolo
# INSTALL_YOLO=true
# YOLO_WEIGHTS=hf://pyronear/yolo11s_sensitive-detector/best.pt   # ou /models/best.pt après fine-tuning

# Secondes entre deux images par caméra (à augmenter si le CPU sature avec YOLO)
INTERVAL=5
