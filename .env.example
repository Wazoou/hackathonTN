# Copier en .env (cp .env.example .env) : docker compose le lit automatiquement.

# Phase 1 : détecteur factice, images légères
DETECTOR=dummy
INSTALL_YOLO=false

# Phase 2 : vrai modèle Pyronear (image caméra ~2,3 Go, inférence sur CPU)
# DETECTOR=yolo
# INSTALL_YOLO=true
# YOLO_WEIGHTS=hf://pyronear/yolo11s_sensitive-detector/best.pt   # ou /models/best.pt après fine-tuning

# Secondes entre deux images par caméra (à augmenter si le CPU sature avec YOLO)
INTERVAL=5

# LIVE / PRÉDICTION : collecteur national toutes les 90 minutes.
# Les nouvelles données sont persistées dans data/weather/ (hors Git).
# Le dossier risk-data/meteo/ doit inclure live_initial_state.npz ; voir LIVE_PREDICTION.md.
# Pour un hébergement sous un préfixe, adapter aussi l’URL publique dans le dashboard :
# WEATHER_PUBLIC_URL=/app/static/weather/current.json
# WEATHER_DATA_DIR=./data/weather
