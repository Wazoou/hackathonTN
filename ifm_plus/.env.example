# Clés optionnelles pour le pipeline IFM+
# Copier en .env : cp .env.example .env

# NASA FIRMS (https://firms.modaps.eosdis.nasa.gov/api/area/)
FIRMS_MAP_KEY=

# Copernicus Early Warning Data Store (https://ewds.climate.copernicus.eu/)
# Préférer ~/.cdsapirc, sinon :
CDSAPI_URL=https://ewds.climate.copernicus.eu/api
CDSAPI_KEY=

# Météo-France (AROME, API publique) — V2 uniquement
METEOFRANCE_API_KEY=
